# ============================================
# BlogVerse - Environment Variables Template
# ============================================
# 📋  Copy this file to .env and fill in your values:
#     cp .env.example .env
#
# ⚠️  NEVER commit .env to version control.
# ============================================

# --- Database ---
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blogverse_db
DB_USERNAME=postgres
DB_PASSWORD=                          # ← Set your PostgreSQL password

# --- JWT Authentication ---
# Secret key for signing JWT tokens (minimum 64 characters)
# Generate one with: openssl rand -base64 64
JWT_SECRET=                           # ← Set a strong random secret
JWT_EXPIRATION_MS=86400000            # Token validity: 24 hours (in milliseconds)

# --- Server ---
SERVER_PORT=8080
